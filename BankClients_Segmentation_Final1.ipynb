          "text": [
            "\n",
            "Hierarchical cluster sizes:\n",
            "  k=2: [2, 4998]\n",
            "  k=3: [2, 1080, 3918]\n",
            "  k=4: [2, 1080, 3818, 100]\n",
            "  k=5: [2, 1080, 3818, 2, 98]\n"
          ]
        }
      ],
      "source": [
        "# =============================================================================\n",
        "# 6.3  Hierarchical Clustering — Exploratory Dendrogram\n",
        "# =============================================================================\n",
        "\n",
        "# ── Convert Gower square matrix to condensed form (scipy requirement) ─────────\n",
        "gower_condensed = squareform(gower_distances, checks=False)\n",
        " \n",
        "# ── Linkage ───────────────────────────────────────────────────────────────────\n",
        "# 'average' (UPGMA) is the standard pairing with Gower: it uses mean\n",
        "# inter-cluster distance and is less sensitive to outliers than 'single'\n",
        "# (chaining) or 'complete' (which overweights the farthest pair).\n",
        "print('⏳ Computing hierarchical linkage (average)...')\n",
        "Z = linkage(gower_condensed, method='average')\n",
        "print('✅ Done.')\n",
        " \n",
        "# ── Dendrogram (truncated — full 5000-leaf tree is unreadable) ────────────────\n",
        "fig, ax = plt.subplots(figsize=(14, 6))\n",
        "dendrogram(\n",
        "    Z,\n",
        "    truncate_mode='lastp',   # show only last p merged clusters\n",
        "    p=30,                    # 30 leaves → readable\n",
        "    leaf_rotation=90,\n",
        "    leaf_font_size=9,\n",
        "    color_threshold=0,       # all same colour (we just want structure)\n",
        "    above_threshold_color='steelblue',\n",
        "    ax=ax\n",
        ")\n",
        "ax.set_title('Hierarchical Clustering — Truncated Dendrogram (average linkage)')\n",
        "ax.set_xlabel('Cluster (size in parentheses)')\n",
        "ax.set_ylabel('Gower distance')\n",
        "ax.grid(True, axis='y', alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        " \n",
        "# ── Horizontal cut lines to compare k choices ────────────────────────────────\n",
        "# The dendrogram y-axis is the merge distance. We find the merge distances\n",
        "# that correspond to k=2,3,4,5 and draw them as reference lines.\n",
        "fig, ax = plt.subplots(figsize=(14, 6))\n",
        "dn = dendrogram(\n",
        "    Z,\n",
        "    truncate_mode='lastp',\n",
        "    p=30,\n",
        "    leaf_rotation=90,\n",
        "    leaf_font_size=9,\n",
        "    color_threshold=0,\n",
        "    above_threshold_color='steelblue',\n",
        "    ax=ax\n",
        ")\n",
        " \n",
        "# Merge distances are in Z[:,2], sorted ascending.\n",
        "# To get k clusters you cut just below the (n-k)-th merge from the bottom,\n",
        "# which is the (k-1)-th merge from the top = Z[-(k-1), 2].\n",
        "n = len(gower_distances)\n",
        "cut_colors = {2: 'red', 3: 'darkorange', 4: 'green', 5: 'purple'}\n",
        "for k, color in cut_colors.items():\n",
        "    # height midway between the (n-k)th and (n-k+1)th merges\n",
        "    h = Z[-(k-1), 2]\n",
        "    ax.axhline(h, color=color, linestyle='--', alpha=0.7,\n",
        "               label=f'k={k} (cut at {h:.3f})')\n",
        " \n",
        "ax.set_title('Dendrogram with cut lines for k = 2, 3, 4, 5')\n",
        "ax.set_xlabel('Cluster (size in parentheses)')\n",
        "ax.set_ylabel('Gower distance')\n",
        "ax.legend(loc='upper right')\n",
        "ax.grid(True, axis='y', alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        " \n",
        "# ── Compare hierarchical labels with K-Medoids for chosen k values ────────────\n",
        "print('\\nHierarchical cluster sizes:')\n",
        "for k in [2, 3, 4, 5]:\n",
        "    hier_labels = fcluster(Z, t=k, criterion='maxclust')\n",
        "    sizes = pd.Series(hier_labels).value_counts().sort_index()\n",
        "    print(f'  k={k}: {sizes.values.tolist()}')"
      ]
    },
