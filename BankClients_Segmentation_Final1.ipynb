        "# ── t-SNE with Gower (2D) ─────────────────────────────────────────────────────\n",
        "print('⏳ Running t-SNE (2D) with Gower distance...')\n",
        "tsne_2d = TSNE(\n",
        "    n_components=2,\n",
        "    metric='precomputed',\n",
        "    init='random',\n",
        "    random_state=42,\n",
        "    perplexity=40,        # tuned: good balance for 5000 points\n",
        "    learning_rate='auto'\n",
        ")\n",
        "Y_2d = tsne_2d.fit_transform(gower_distances)\n",
        "print('✅ t-SNE done.')\n",
        "\n",
