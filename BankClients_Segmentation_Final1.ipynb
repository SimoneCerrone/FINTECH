      "source": [
        "# ── PCA ────────────────────────────────────────────────────────────────────────\n",
        "pca = PCA(n_components=10, random_state=42)\n",
        "X_pca_full = pca.fit_transform(X)\n",
        "\n",
        "# Explained variance\n",
        "explained = pca.explained_variance_ratio_\n",
        "cumulative = np.cumsum(explained)\n",
