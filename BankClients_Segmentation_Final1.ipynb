            "Numerical columns:   ['Age', 'FamilySize', 'Income', 'Wealth', 'Debt', 'FinEdu', 'ESG', 'Digital', 'BankFriend', 'LifeStyle', 'Luxury', 'Saving']\n"
          ]
        }
      ],
      "source": [
        "# ── Define categorical and numerical columns ───────────────────────────────────\n",
        "categorical_columns = ['Gender', 'Job', 'Area', 'Investments', 'CitySize'] # per aggiungere CitySize alle categoriche bisogna modificare anche sotto\n",
        "\n",
        "# BUG FIX: define categorical_features BEFORE using .astype()\n",
        "categorical_features = df[categorical_columns].copy()\n",
        "categorical_features = categorical_features.astype('category')\n",
        "\n",
        "numerical_columns = [col for col in df.columns if col not in categorical_columns]\n",
        "numerical_features = df[numerical_columns].copy()\n",
        "\n",
        "print('Categorical columns:', categorical_columns)\n",
        "print('Numerical columns:  ', numerical_columns)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oiL9ZkeyZee4",
        "outputId": "be1cc8c7-1892-4ec5-e304-f9ef426725a5"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Numerical features shape : (5000, 12)\n",
            "  ↳ Scaled (Age, FamilySize): 2\n",
