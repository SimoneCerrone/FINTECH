        "plt.figure(figsize=(10, 4))\n",
        "plt.bar(range(1, 11), explained * 100, alpha=0.7, label='Individual')\n",
        "plt.plot(range(1, 11), cumulative * 100, marker='o', color='red', label='Cumulative')\n",
